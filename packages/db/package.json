{
  "name": "@baza/db",
  "version": "0.0.1",
  "description": "Baza shared database utilities and configurations",
  "private": true,
  "main": "src/client.ts",
  "types": "src/client.ts",
  "type": "module",
  "exports": {
    ".": {
      "import": "./src/client.ts",
      "types": "./src/client.ts"
    },
    "./schemas": {
      "import": "./src/schemas/index.ts",
      "types": "./src/schemas/index.ts"
    },
    "./validators": {
      "import": "./src/validators/index.ts",
      "types": "./src/validators/index.ts"
    }
  },
  "scripts": {
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/seed.ts"
  },
  "dependencies": {
    "dotenv": "^17.3.1",
    "drizzle-orm": "1.0.0-beta.20"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "drizzle-kit": "1.0.0-beta.20"
  }
}
