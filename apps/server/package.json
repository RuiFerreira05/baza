{
  "name": "@baza/server",
  "version": "0.0.1",
  "description": "Baza server package",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsup",
    "start": "node dist/server.js",
    "generate-auth-schema": "pnpm dlx auth@latest generate --output ../../packages/db/src/schemas/auth.ts",
    "test": "vitest run",
    "lint": "eslint ."
  },
  "dependencies": {
    "@baza/db": "workspace:*",
    "@baza/shared-types": "workspace:*",
    "@better-auth/drizzle-adapter": "^1.5.6",
    "@better-auth/expo": "^1.5.6",
    "@fastify/multipart": "^10.0.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@fastify/type-provider-typebox": "^6.1.0",
    "better-auth": "^1.5.6",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "typebox": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "eslint": "^9.39.4",
    "tsup": "^8.5.1",
    "tsx": "^4.21.0",
    "typescript-eslint": "^8.61.1",
    "vitest": "^4.1.8"
  }
}